# DOSTAWCA AI — "openai" (domyślny) lub "anthropic"
LLM_PROVIDER=openai

# OPENAI — wymagany gdy LLM_PROVIDER=openai (domyślnie)
OPENAI_API_KEY=sk-...
# Model OpenAI (opcjonalnie, domyślnie gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC — wymagany tylko gdy LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model Anthropic (opcjonalnie, domyślnie claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SUPABASE — wymagany (darmowy tier na supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OPENROUTESERVICE — darmowy klucz na openrouteservice.org (5000 req/dzień)
ORS_API_KEY=5b3ce3...

# OPENAQ — darmowy, bez klucza (opcjonalnie z kluczem dla wyższych limitów)
OPENAQ_API_KEY=

# URL aplikacji
NEXT_PUBLIC_APP_URL=http://localhost:3000

# STRIPE — opcjonalnie (tylko jeśli chcesz płatności)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
